PORT=8787
JWT_SECRET=CHANGE_TO_A_RANDOM_64_CHARACTER_VALUE
DEVICE_TOKEN=CHANGE_TO_ANOTHER_RANDOM_64_CHARACTER_VALUE
PUBLIC_ORIGIN=http://localhost:8787
DATA_PATH=data/wardrobe.json
OFFLINE_TIMEOUT_MS=10000
GATEWAY_OFFLINE_TIMEOUT_MS=30000
COMMAND_TIMEOUT_MS=60000
# Leave empty for safe local JSON mode. For the cloud beta, set this to the
# Neon pooled PostgreSQL URL with sslmode=require. Never commit real credentials.
# Transfer existing production settings privately from Vercel when needed.
DATABASE_URL=
PG_POOL_MAX=2
# Server-side administrator. Set this to the sole real administrator email.
ADMIN_EMAIL=
# This second factor is checked only on the server and must never be committed.
ADMIN_SECONDARY_PASSWORD=
ADMIN_SESSION_TTL_MS=900000
# Optional photo pipeline. Keep secrets in server settings, never in web code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GARMENT_BUCKET=garments
IMAGE_PROCESSOR_URL=
IMAGE_PROCESSOR_TOKEN=
IMAGE_PROCESSING_PROFILE=fast
