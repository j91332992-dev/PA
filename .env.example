PORT=8787
JWT_SECRET=CHANGE_TO_A_RANDOM_64_CHARACTER_VALUE
DEVICE_TOKEN=CHANGE_TO_ANOTHER_RANDOM_64_CHARACTER_VALUE
PUBLIC_ORIGIN=http://localhost:8787
DATA_PATH=data/wardrobe.json
OFFLINE_TIMEOUT_MS=30000
COMMAND_TIMEOUT_MS=15000
# Leave empty for safe local JSON mode. For the cloud beta, set this to the
# Supabase Transaction Pooler connection string in Render only. Never commit it.
DATABASE_URL=
PG_POOL_MAX=10
# Server-side administrator. Set this to the real email of account hpo2002.
ADMIN_EMAIL=
# Default server-side administrator username. Change only in server env when
# transferring administration; the browser never decides this role.
ADMIN_USERNAME=hpo2002
# Cloud photo pipeline. Keep all secrets in Render/Supabase, never in web code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GARMENT_BUCKET=garments
IMAGE_PROCESSOR_URL=
IMAGE_PROCESSOR_TOKEN=
IMAGE_PROCESSING_PROFILE=fast
